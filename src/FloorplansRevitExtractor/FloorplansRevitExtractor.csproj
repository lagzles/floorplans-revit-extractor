<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FloorplansRevitExtractor</RootNamespace>
    <AssemblyName>FloorplansRevitExtractor</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitAddinsDir>$(ProgramData)\Autodesk\Revit\Addins\2024\FloorplansRevitExtractor</RevitAddinsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloorplansRevitExtractor.Core\FloorplansRevitExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FloorplansRevitExtractor.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Installs the build into Revit 2024 so the plugin loads next time Revit
    starts. Revit only reads .addin manifests at the root of the Addins4
    folder, never in subfolders: the manifest goes to the root and points at
    the DLLs in the FloorplansRevitExtractor subfolder (every dependency DLL,
    including FloorplansRevitExtractor.Core and its transitive packages).
    Debug-only: don't touch a machine-wide folder on a Release/CI build.
  -->
  <Target Name="DeployToRevitAddinsFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)" Condition="!Exists('$(RevitAddinsDir)')" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(OutDir)FloorplansRevitExtractor.addin" DestinationFolder="$(RevitAddinsDir)\.." />
    <Delete Files="$(RevitAddinsDir)\FloorplansRevitExtractor.addin" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FloorplansRevitExtractor</RootNamespace>
    <AssemblyName>FloorplansRevitExtractor</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitAddinsDir>$(ProgramData)\Autodesk\Revit\Addins\2024\FloorplansRevitExtractor</RevitAddinsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloorplansRevitExtractor.Core\FloorplansRevitExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FloorplansRevitExtractor.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Copies the built addin (and every dependency DLL, including
    FloorplansRevitExtractor.Core and its transitive packages) into the
    Revit 2024 addins folder so the plugin loads automatically next time
    Revit starts. Debug-only: don't touch a machine-wide folder on a
    Release/CI build.
  -->
  <Target Name="DeployToRevitAddinsFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)*.dll" />
      <DeployFiles Include="$(OutDir)FloorplansRevitExtractor.addin" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)" Condition="!Exists('$(RevitAddinsDir)')" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)" />
  </Target>

</Project>

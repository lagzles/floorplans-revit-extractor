<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FloorplansRevitExtractor</RootNamespace>
    <AssemblyName>FloorplansRevitExtractor</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitAddinsDir>$(ProgramData)\Autodesk\Revit\Addins\2024\FloorplansRevitExtractor</RevitAddinsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloorplansRevitExtractor.Core\FloorplansRevitExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FloorplansRevitExtractor.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    No install step: Revit loads the plugin straight from this build output
    through a manifest in the user's Addins folder
    (%AppData%\Autodesk\Revit\Addins4\FloorplansRevitExtractor.addin,
    Assembly = the full path of bin\Debug\FloorplansRevitExtractor.dll). A
    second manifest with the same AddInId would make Revit report a conflict.
  -->

</Project>
